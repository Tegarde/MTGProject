rules_version = '2';

// Deploy before the first write — a new Firestore database in test mode is
// world-writable and expires after 30 days. See planning/04-firestore-model.md §6.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
